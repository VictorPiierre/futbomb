{
  "name": "futbomb",
  "version": "1.0.0",
  "private": true,
  "description": "Pavio Curto — jogo multiplayer de palavras em tempo real",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "import": "tsx scripts/import-names.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "typecheck": "tsc --noEmit -p .",
    "fetch:wikidata": "tsx scripts/fetch-wikidata.ts",
    "build:extra": "tsx scripts/build-extra.ts",
    "smoke:stop": "tsx scripts/smoke-stop.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
